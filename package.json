{
  "name": "tagcheck",
  "version": "2.2.0",
  "description": "Scan a motorcycle number plate to check whether your club has already tagged that bike, then tag it if nobody has.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server/src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/src/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\"",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project tagcheck-rules-test \"node --test test/firestore-rules.spec.mjs\"",
    "build:web": "node tools/build-web.mjs",
    "firebase:deploy": "npm run build:web && npx --yes firebase-tools@15 deploy",
    "firebase:rules": "npx --yes firebase-tools@15 deploy --only firestore:rules",
    "firebase:emulate": "npm run build:web && npx --yes firebase-tools@15 emulators:start",
    "icons": "node tools/make-icons.mjs",
    "seed": "node --disable-warning=ExperimentalWarning tools/seed.mjs",
    "vendor:ocr": "node tools/vendor-ocr.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "keywords": [
    "motorcycle",
    "number-plate",
    "licence-plate",
    "ocr",
    "pwa",
    "outreach"
  ]
}
