rules_version = '2';

// TagCheck security rules.
//
// These rules are the whole security model: there is no server to check
// anything, so what is written here is what is enforced.
//
// The important one is on /tags: create is allowed, update never is. Because a
// tag document is keyed by the plate itself, a second person tagging the same
// bike is attempting an update, and Firestore refuses it. That is the same
// guarantee the self-hosted version gets from a unique index, and it holds even
// when two phones write in the same instant.
//
// Everyone who joins is equal. The club is a group of friends, so any member
// may remove any tag -- the common case is fixing someone else's mistake while
// they are not around, and locking that down helps nobody.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.uid);
    }

    function isMember() {
      return signedIn() && exists(memberPath());
    }

    // Readable by the rules engine even though no client may read it.
    function joinCode() {
      return get(/databases/$(database)/documents/config/secrets).data.joinCode;
    }

    // The club name, shown before anyone joins.
    match /config/public {
      allow read: if true;
      allow write: if false;
    }

    // The join code, which lives in the invite link rather than in anyone's
    // head. No client may read this; only the rules above consult it.
    match /config/secrets {
      allow read, write: if false;
    }

    match /members/{uid} {
      // Your own record only. Names are copied onto tags, so nothing here is
      // needed to render the app.
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.code == joinCode();

      // A member may correct their own name.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.code == resource.data.code
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40;

      allow delete: if false;
    }

    match /tags/{plateId} {
      allow read: if isMember();

      allow create: if isMember()
        // The document id is the canonical plate, which is what makes a
        // duplicate tag an update, and updates are refused below.
        && request.resource.data.plate == plateId
        && request.resource.data.memberUid == request.auth.uid
        && request.resource.data.memberName is string
        && request.resource.data.memberName.size() <= 40
        && request.resource.data.fuzzy is string
        && request.resource.data.format is string
        && request.resource.data.createdAt == request.time
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 280));

      // A tag is a record of something that happened. It is never edited.
      allow update: if false;

      // Any member may remove a tag: the sign fell off, or it was a mistake.
      // Removing one frees the bike to be tagged again.
      allow delete: if isMember();
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
