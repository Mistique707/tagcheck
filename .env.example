# Copy to .env and edit, or set these in your host's dashboard.
# Start the server with:  node --env-file=.env server/src/index.js

# What members see at the top of the app.
CLUB_NAME=Night Owls MC

# The club code. Nobody types it: put it in the invite link you share, as
#   https://your-address/#join=THECODE
# Leave blank and the server generates one and prints it at startup.
JOIN_CODE=

# Signs the tokens on members' phones. Any long random string.
# If unset, a new one is generated per restart and everyone is signed out.
JWT_SECRET=

# Where the SQLite file lives. Point this at a mounted volume in production.
DB_FILE=data/tagcheck.db

PORT=3000
HOST=0.0.0.0

# Optional: the join/enquiry link your paper signs point at. Shown in the app.
JOIN_URL=

# Only needed when the app is hosted somewhere other than this server
# (for example on GitHub Pages). Comma-separated list of allowed origins.
CORS_ORIGIN=

# Set to 1 behind a reverse proxy or platform load balancer so rate limiting
# sees real client addresses.
TRUST_PROXY=
